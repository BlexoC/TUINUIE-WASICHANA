# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tuinuie_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tuinuie_test

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_APP=wsgi.py
FLASK_ENV=development
